        },
        {
          "code": "M01",
          "name": "程序选择性停止",
          "format": "M01",
          "description": "当机床面板上的'选择性停止'键处于开启状态时暂停程序",
          "example": "M01",
          "relatedCodes": [
            "M00"
          ],
          "source": "kb-00031"
        },
        {
          "code": "M03",
