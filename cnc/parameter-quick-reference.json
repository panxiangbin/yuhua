        {
          "code": "M00",
          "name": "程序无条件停止",
          "format": "M00",
          "description": "暂停程序执行，机床各轴停止，便于手工测量或调头",
          "example": "M00 (暂停测量尺寸)",
          "relatedCodes": [
            "M01"
