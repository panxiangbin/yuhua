          "description": "停止冷却液泵运行，便于观察或完成加工段",
          "example": "M09",
          "relatedCodes": [
            "M08"
          ],
          "source": "kb-00037"
        },
        {
          "code": "M30",
          "name": "程序结束并返回起点",
